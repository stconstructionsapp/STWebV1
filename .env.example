# ============================================================
# ST CONSTRUCTIONS GROUP - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Rename this file to .env for local testing or configure these
# environment variables in your Hostinger Node.js Application dashboard.

# HOSTINGER SERVER CONFIGURATION
# Hostinger assigns the port dynamically via process.env.PORT.
# Default fallback for local testing is 3000.
PORT=3000
NODE_ENV=production

# CANONICAL DOMAIN & APP URL
# Official production website URL
APP_URL=https://stconstructionsgroup.com

# LEAD CAPTURE & CRM INTEGRATION (OPTIONAL)
# If you have an external CRM webhook (Zapier, Make, Zoho, Pipedrive, WhatsApp Business API),
# provide the endpoint URL below. Leads from /api/enquiries will automatically forward here.
CRM_WEBHOOK_URL=

# CLIENT-SIDE WEB3FORMS BACKUP KEY (OPTIONAL)
# Used for direct client-side fallback email delivery
VITE_WEB3FORMS_ACCESS_KEY=3c1cb5ad-22b3-400b-b9c9-b79bb0371e65
