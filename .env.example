# ============================================================
# ST CONSTRUCTIONS GROUP - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy to .env for local testing (never commit .env), or configure
# these variables in Hostinger Node.js Web App Hosting.

# Hostinger runtime port & bind address (Hostinger assigns PORT automatically)
PORT=
HOST=

# Node runtime mode (set to production on Hostinger)
NODE_ENV=

# Primary canonical production URL (e.g. https://stconstructionsgroup.com)
APP_URL=

# Server-side Web3Forms access key for email lead notifications (optional)
WEB3FORMS_ACCESS_KEY=

# Server-side external CRM webhook endpoint for lead forwarding (optional)
CRM_WEBHOOK_URL=
